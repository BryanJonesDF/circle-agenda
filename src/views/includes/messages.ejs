<% if (errors.length > 0) { %>
  <% errors.forEach(error => { %>
    <div class="alert alert-danger app-alert" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
      <span><%= error %></span>
    </div>
  <% }) %>
<% } %>

<% if (success.length > 0) { %>
  <% success.forEach(msg => { %>
    <div class="alert alert-success app-alert" role="status">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
      <span><%= msg %></span>
    </div>
  <% }) %>
<% } %>
