<%- include('includes/head') %>
<%- include('includes/nav') %>

<main class="container py-5">
  <%- include('includes/messages') %>

  <div class="row g-4 justify-content-center">

    <div class="col-md-6 col-lg-5">
      <div class="app-card h-100">
        <h2 class="app-card-title">Entrar</h2>
        <p class="app-muted mb-4">Já tem conta? Acesse sua agenda.</p>

        <form action="/login/login" method="POST" class="form-login" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="login-email" class="form-label">E-mail</label>
            <input type="email" id="login-email" name="email" class="form-control" placeholder="seu@email.com">
          </div>
          <div class="mb-4">
            <label for="login-password" class="form-label">Senha</label>
            <input type="password" id="login-password" name="password" class="form-control" placeholder="Sua senha">
          </div>
          <button type="submit" class="btn btn-accent w-100">Entrar</button>
        </form>
      </div>
    </div>

    <div class="col-md-6 col-lg-5">
      <div class="app-card h-100">
        <h2 class="app-card-title">Criar conta</h2>
        <p class="app-muted mb-4">Novo por aqui? Cadastre-se em segundos.</p>

        <form action="/login/register" method="POST" class="form-cadastro" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label for="cadastro-email" class="form-label">E-mail</label>
            <input type="email" id="cadastro-email" name="email" class="form-control" placeholder="seu@email.com">
          </div>
          <div class="mb-4">
            <label for="cadastro-password" class="form-label">Senha</label>
            <input type="password" id="cadastro-password" name="password" class="form-control" placeholder="Entre 3 e 50 caracteres">
          </div>
          <button type="submit" class="btn btn-outline-light w-100">Criar conta</button>
        </form>
      </div>
    </div>

  </div>
</main>

<%- include('includes/footer') %>