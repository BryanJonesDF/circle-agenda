<%- include('includes/head') %>
<%- include('includes/nav') %>

<main class="container py-5">
  <div class="app-medium mx-auto">
    <%- include('includes/messages') %>

    <div class="text-center mb-5">
      <h1 class="app-title mb-2">Acesse sua agenda</h1>
      <p class="app-muted mb-0">Entre com sua conta ou crie uma nova em poucos segundos.</p>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="app-panel h-100">
          <h2 class="app-panel-title">Entrar</h2>
          <p class="app-muted mb-4">Já tem conta? Use seu e-mail e senha.</p>

          <form action="/login/login" method="POST" class="form-login" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="login-email" class="form-label">E-mail</label>
              <input type="email" id="login-email" name="email" class="form-control" placeholder="seu@email.com" autocomplete="email">
            </div>
            <div class="mb-4">
              <label for="login-password" class="form-label">Senha</label>
              <input type="password" id="login-password" name="password" class="form-control" placeholder="Sua senha" autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-accent w-100">Entrar</button>
          </form>
        </div>
      </div>

      <div class="col-md-6">
        <div class="app-panel h-100">
          <h2 class="app-panel-title">Criar conta</h2>
          <p class="app-muted mb-4">Novo por aqui? É grátis.</p>

          <form action="/login/register" method="POST" class="form-cadastro" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="cadastro-email" class="form-label">E-mail</label>
              <input type="email" id="cadastro-email" name="email" class="form-control" placeholder="seu@email.com" autocomplete="email">
            </div>
            <div class="mb-4">
              <label for="cadastro-password" class="form-label">Senha</label>
              <input type="password" id="cadastro-password" name="password" class="form-control" placeholder="Entre 3 e 50 caracteres" autocomplete="new-password">
            </div>
            <button type="submit" class="btn btn-ghost w-100">Criar conta</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('includes/footer') %>
