<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
  <div class="row">
    <div class="col-lg-2"></div>

    <div class="col-lg-8 my-3">
      <h1 class="text-center">Login ou criar conta</h1>
      <p class="text-center lead">Faça login ou crie sua conta abaixo.</p>

      <div class="row">
        <!-- Coluna: criar conta -->
        <div class="col-lg">
          <h2>Criar conta</h2>
          <p>Se você ainda não tem conta, preencha o formulário abaixo.</p>

          <form action="/login/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input type="email" name="email" class="form-control">
            </div>

            <div class="mb-3">
              <label class="form-label">Senha</label>
              <input type="password" name="password" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary">Criar minha conta</button>
          </form>
        </div>

        <!-- Coluna: entrar -->
        <div class="col-lg">
          <h2>Entrar</h2>
          <p>Se você já tem uma conta, faça login abaixo.</p>

          <form action="/login/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="mb-3">
              <label class="form-label">E-mail</label>
              <input type="email" name="email" class="form-control">
            </div>

            <div class="mb-3">
              <label class="form-label">Senha</label>
              <input type="password" name="password" class="form-control">
            </div>

            <button type="submit" class="btn btn-primary">Entrar</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-2"></div>
  </div>
</div>

<%- include('includes/footer') %>