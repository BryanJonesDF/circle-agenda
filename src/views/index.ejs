<%- include('includes/head') %>
<%- include('includes/nav') %>

<main class="container py-5">
  <%- include('includes/messages') %>

  <% if (!locals.user) { %>

    <section class="app-hero text-center">
      <h1 class="app-title">Seus contatos, organizados.</h1>
      <p class="app-subtitle">Uma agenda simples e privada. Crie sua conta e comece a cadastrar.</p>
      <a href="/login/index" class="btn btn-accent btn-lg">Começar agora</a>
    </section>

  <% } else { %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h1 class="app-title mb-1">Meus contatos</h1>
        <p class="app-muted mb-0"><%= contatos.length %> contato(s)</p>
      </div>
      <a href="/contato/index" class="btn btn-accent">+ Novo contato</a>
    </div>

    <% if (contatos.length > 0) { %>
      <div class="app-card p-0">
        <div class="table-responsive">
          <table class="table app-table mb-0 align-middle">
            <thead>
              <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Telefone</th>
                <th class="text-end">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% contatos.forEach(contato => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <span class="app-avatar"><%= contato.nome.charAt(0).toUpperCase() %></span>
                      <span><%= contato.nome %> <%= contato.sobrenome %></span>
                    </div>
                  </td>
                  <td class="app-muted"><%= contato.email || '—' %></td>
                  <td class="app-muted"><%= contato.telefone || '—' %></td>
                  <td class="text-end text-nowrap">
                    <a href="/contato/index/<%= contato._id %>" class="btn btn-sm btn-outline-light me-1">Editar</a>
                    <form action="/contato/delete/<%= contato._id %>" method="POST" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="app-card text-center py-5">
        <p class="app-muted mb-3">Você ainda não tem contatos na sua agenda.</p>
        <a href="/contato/index" class="btn btn-accent">Cadastrar o primeiro</a>
      </div>
    <% } %>

  <% } %>
</main>

<%- include('includes/footer') %>