<%- include('includes/head') %>
<%- include('includes/nav') %>

<main class="container py-5">
  <%- include('includes/messages') %>

  <% if (!locals.user) { %>

    <section class="app-hero">
      <div class="row align-items-center g-5">
        <div class="col-lg-6">
          <h1 class="app-hero-title">Todas as pessoas que importam, num só lugar.</h1>
          <p class="app-hero-text">Guarde nomes, e-mails e telefones numa agenda privada, que só você acessa, no computador ou no celular.</p>
          <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-md-start">
            <a href="/login/index" class="btn btn-accent btn-lg">Criar minha conta</a>
            <a href="/login/index" class="btn btn-ghost btn-lg">Já tenho conta</a>
          </div>
        </div>

        <div class="col-lg-6">
          <div class="app-orbit" aria-hidden="true">
            <div class="app-orbit-center"></div>
            <div class="app-orbit-ring">
              <span class="app-avatar cor-0">A</span>
              <span class="app-avatar cor-1">M</span>
              <span class="app-avatar cor-2">J</span>
              <span class="app-avatar cor-3">L</span>
              <span class="app-avatar cor-4">R</span>
              <span class="app-avatar cor-5">P</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="row app-features g-4">
      <div class="col-md-4 app-feature px-md-4">
        <h3>Só você vê seus contatos</h3>
        <p>Cada conta tem a própria agenda. Ninguém mais acessa o que você cadastrou.</p>
      </div>
      <div class="col-md-4 app-feature px-md-4">
        <h3>Cadastro em segundos</h3>
        <p>Nome e um e-mail ou telefone já bastam para salvar um contato.</p>
      </div>
      <div class="col-md-4 app-feature px-md-4">
        <h3>Feita para o celular</h3>
        <p>A agenda se ajusta à tela, para você consultar seus contatos onde estiver.</p>
      </div>
    </section>

  <% } else { %>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <h1 class="app-title mb-1">Meus contatos</h1>
        <p class="app-muted mb-0">
          <%= contatos.length === 1 ? '1 contato' : contatos.length + ' contatos' %>
        </p>
      </div>
      <a href="/contato/index" class="btn btn-accent">Novo contato</a>
    </div>

    <% if (contatos.length > 0) { %>
      <ul class="app-list">
        <% contatos.forEach(contato => { %>
          <li class="app-list-item">
            <div class="app-contact-name">
              <span class="app-avatar cor-<%= contato.nome.charCodeAt(0) % 6 %>"><%= contato.nome.charAt(0).toUpperCase() %></span>
              <span class="text-truncate"><%= contato.nome %> <%= contato.sobrenome %></span>
            </div>

            <div class="app-contact-info">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              <span class="text-truncate"><%= contato.email || 'Sem e-mail' %></span>
            </div>

            <div class="app-contact-info">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
              <span class="text-truncate"><%= contato.telefone || 'Sem telefone' %></span>
            </div>

            <div class="app-actions">
              <a href="/contato/index/<%= contato._id %>" class="btn btn-icon" title="Editar" aria-label="Editar <%= contato.nome %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </a>
              <form action="/contato/delete/<%= contato._id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-icon btn-icon-danger" title="Excluir" aria-label="Excluir <%= contato.nome %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                </button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="app-panel app-empty">
        <span class="app-avatar app-avatar-lg cor-0 mb-3">+</span>
        <h2 class="app-panel-title">Sua agenda está vazia</h2>
        <p class="app-muted mb-4">Cadastre o primeiro contato para começar.</p>
        <a href="/contato/index" class="btn btn-accent">Cadastrar contato</a>
      </div>
    <% } %>

  <% } %>
</main>

<%- include('includes/footer') %>
